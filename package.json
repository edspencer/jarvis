{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "A browser walkthrough for a building's digital twin (three.js), with live data layered on through plugins.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate-site": "node tools/validate-site.ts",
    "demo-site": "node tools/make-demo-site.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "home-assistant-js-websocket": "9.7.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/three": "0.186.0",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "meshoptimizer": "1.3.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
