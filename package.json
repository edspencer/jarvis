{
  "name": "jarvis",
  "version": "0.3.0",
  "private": true,
  "description": "A browser walkthrough for a building's digital twin (three.js), with live data layered on through plugins.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./plugin": "./src/plugin-api.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "node tools/build-pages.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pages": "playwright test -c playwright.pages.config.ts",
    "validate-site": "node tools/validate-site.ts",
    "demo-site": "node tools/make-demo-site.ts",
    "screenshots": "node tools/screenshots.ts",
    "notices": "node tools/third-party-notices.ts",
    "bundle-size": "node tools/bundle-size.ts",
    "build-plugin": "node tools/build-plugin.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "home-assistant-js-websocket": "9.7.0",
    "lit": "3.3.3",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.3.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edspencer/jarvis.git"
  },
  "homepage": "https://github.com/edspencer/jarvis",
  "bugs": {
    "url": "https://github.com/edspencer/jarvis/issues"
  }
}
