{
  "name": "jarvis-assistant",
  "version": "0.0.0",
  "private": true,
  "description": "The optional JARVIS voice assistant server: a Claude Agent SDK session behind one WebSocket, with a server-enforced Home Assistant policy.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run --root . test"
  }
}
